{
  "name": "bosszhipin-autotools",
  "private": true,
  "version": "0.13.0",
  "description": "Local-first job collection, resume matching and outreach drafts for BOSS Zhipin",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/LiyuLiu8270/BossZhipin-AutoTools.git"},
  "type": "module",
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "doctor": "node scripts/doctor.mjs",
    "start": "node local/desktop.mjs",
    "build:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "serve": "node local/automation.mjs serve",
    "stop": "node local/automation.mjs stop",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs"
  }
}
